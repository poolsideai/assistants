# Use a static action environment (including PATH) so environment changes don't invalidate Bazel's
# action cache and cause unnecessary rebuilds. e.g. between CI workers and the remote cache. 
# This will default to true in Bazel 9.0.0. See https://github.com/bazelbuild/bazel/pull/27670
common --incompatible_strict_action_env

