{
  "$schema": "https://turborepo.org/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "PORT",
    "LOCAL_SCHEMA",
    "CHOKIDAR_USEPOLLING"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["GH_TOKEN", "APP_TYPE", "BUILD_COMMIT"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!e2e/**",
        "!tests/**",
        "!**/*.test.ts",
        "!**/*.stories.svelte"
      ],
      "outputLogs": "new-only",
      "outputs": ["dist/**", ".svelte-kit/**", "tsconfig.build.tsbuildinfo"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "check:format": {
      "outputLogs": "new-only",
      "outputs": ["node_modules/.cache/prettier/.prettier-cache"]
    },
    "check:lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:types": {
      "dependsOn": ["^check:types"],
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "env": ["APP_TYPE"],
      "dependsOn": ["^build"],
      "persistent": true
    },
    "fix:format": {
      "outputLogs": "new-only",
      "outputs": ["node_modules/.cache/prettier/.prettier-cache"]
    },
    "fix:lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "prepare:test:storybook": {
      "cache": false
    },
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "publish:storybook": {
      "dependsOn": ["build:storybook"],
      "env": ["CHROMATIC_PROJECT_TOKEN"]
    },
    "storybook": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:storybook": {
      "dependsOn": ["prepare:test:storybook", "^build"]
    },
    "test:storybook:watch": {
      "cache": false,
      "dependsOn": ["prepare:test:storybook", "^build"],
      "persistent": true
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit:watch": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "test:watch": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    }
  }
}
