load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "version",
    srcs = ["version.go"],
    importpath = "github.com/poolsideai/assistant/pkg/common/version",
    visibility = ["//visibility:public"],
    x_defs = {
        "github.com/poolsideai/assistant/pkg/common/version.Commit": "{GIT_COMMIT}",
        "github.com/poolsideai/assistant/pkg/common/version.BuildTime": "{BUILD_TIME}",
        "github.com/poolsideai/assistant/pkg/common/version.Tag": "{STABLE_VERSION_TAG}",
    },
)

go_test(
    name = "version_test",
    srcs = ["version_test.go"],
    embed = [":version"],
    deps = ["@com_github_stretchr_testify//assert"],
)
