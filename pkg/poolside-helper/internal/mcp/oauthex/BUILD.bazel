load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "oauthex",
    srcs = [
        "auth_meta.go",
        "dcr.go",
        "doc.go",
        "oauth2.go",
        "oauthex.go",
        "resource_meta.go",
    ],
    importpath = "github.com/poolsideai/assistant/pkg/poolside-helper/internal/mcp/oauthex",
    visibility = ["//pkg/poolside-helper:__subpackages__"],
    deps = ["@org_golang_x_net//publicsuffix"],
)

go_test(
    name = "oauthex_test",
    srcs = [
        "auth_meta_test.go",
        "dcr_test.go",
        "oauth2_test.go",
        "oauthex_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":oauthex"],
    deps = [
        "@com_github_golang_jwt_jwt_v5//:jwt",
        "@com_github_google_go_cmp//cmp",
        "@com_github_stretchr_testify//require",
    ],
