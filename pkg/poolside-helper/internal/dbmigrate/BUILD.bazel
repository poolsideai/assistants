load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dbmigrate",
    srcs = ["migrate.go"],
__POOL_SYNTHETIC_IMPORT_BASELINE__
    visibility = ["//pkg/poolside-helper:__subpackages__"],
    deps = [
        "@com_github_golang_migrate_migrate_v4//:migrate",
        "@com_github_golang_migrate_migrate_v4//database/sqlite3",
        "@com_github_golang_migrate_migrate_v4//source",
        "@com_github_golang_migrate_migrate_v4//source/iofs",
    ],
)

go_test(
    name = "dbmigrate_test",
    srcs = ["migrate_test.go"],
    data = glob(["testdata/**"]),
    embedsrcs = [
        "testdata/migrations/20250101000001_create_widget.down.sql",
        "testdata/migrations/20250101000001_create_widget.up.sql",
        "testdata/migrations/20250201000001_add_color.down.sql",
        "testdata/migrations/20250201000001_add_color.up.sql",
    ],
    deps = [
        ":dbmigrate",
        "@com_github_mattn_go_sqlite3//:go-sqlite3",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
