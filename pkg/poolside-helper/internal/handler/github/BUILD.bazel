load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "github",
    srcs = [
        "client.go",
        "git.go",
        "handler.go",
        "status.go",
    ],
    importpath = "github.com/poolsideai/assistant/pkg/poolside-helper/internal/handler/github",
    visibility = ["//pkg/poolside-helper:__subpackages__"],
    deps = [
        "//pkg/common/secrets",
        "//pkg/poolside-helper/methods",
        "@com_github_pkg_errors//:errors",
        "@com_github_tliron_glsp//:glsp",
    ],
