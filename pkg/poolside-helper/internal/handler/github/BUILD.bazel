go_test(
    name = "github_test",
    srcs = [
        "handler_test.go",
        "status_test.go",
    ],
    embed = [":github"],
    deps = [
        "//pkg/common/secrets",
        "//pkg/poolside-helper/methods",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
