{
  "name": "@poolsideai/spoolside",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts}'",
    "check:types": "tsc --project tsconfig.check.json",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts}' --fix",
    "start": "bash install.sh && tsx src/server.ts --dev --use-profile",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
__POOL_SYNTHETIC_IMPORT_BASELINE__
    "diff": "^7.0.0",
    "jsonc-parser": "^3.3.1",
    "playwright": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@poolsideai/eslint-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "@types/diff": "^7.0.2",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
