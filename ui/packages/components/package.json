{
  "name": "@poolsideai/components",
  "version": "2.3.53",
  "private": true,
  "type": "module",
  "imports": {
    "#tailwind.css": "./src/lib/components/tailwind.css"
  },
  "exports": {
    ".": {
      "development": "./src/lib/index.ts",
      "default": "./dist/index.js"
    },
    "./assistant-ui": {
      "development": "./src/lib/components/assistant-ui/index.ts",
      "default": "./dist/components/assistant-ui/index.js"
    },
    "./badge": {
      "development": "./src/lib/components/badge/index.ts",
      "default": "./dist/components/badge/index.js"
    },
    "./button": {
      "development": "./src/lib/components/button/index.ts",
      "default": "./dist/components/button/index.js"
    },
    "./boundary": {
      "development": "./src/lib/components/boundary/index.ts",
      "svelte": "./dist/components/boundary/index.js",
      "default": "./dist/components/boundary/index.js"
    },
    "./checkbox": {
      "development": "./src/lib/components/checkbox/index.ts",
      "default": "./dist/components/checkbox/index.js"
    },
    "./clipboard": {
      "development": "./src/lib/components/clipboard/index.ts",
      "default": "./dist/components/clipboard/index.js"
    },
    "./collapsible": {
      "development": "./src/lib/components/collapsible/index.ts",
      "default": "./dist/components/collapsible/index.js"
    },
    "./diff": {
      "development": "./src/lib/components/diff/index.ts",
      "default": "./dist/components/diff/index.js"
    },
    "./editor": {
      "development": "./src/lib/components/editor/index.ts",
      "default": "./dist/components/editor/index.js"
    },
    "./file-diff": {
      "development": "./src/lib/components/file-diff/index.ts",
      "default": "./dist/components/file-diff/index.js"
    },
    "./icon": {
      "development": "./src/lib/components/icon/index.ts",
      "default": "./dist/components/icon/index.js"
    },
    "./interactive-logo": {
      "development": "./src/lib/components/interactive-logo/index.ts",
      "default": "./dist/components/interactive-logo/index.js"
    },
    "./kbd": {
      "development": "./src/lib/components/kbd/index.ts",
      "default": "./dist/components/kbd/index.js"
    },
    "./markdown": {
      "development": "./src/lib/components/markdown/index.ts",
      "default": "./dist/components/markdown/index.js"
    },
    "./prompt": {
      "development": "./src/lib/components/prompt/index.ts",
      "default": "./dist/components/prompt/index.js"
    },
    "./zigzag-error": {
      "development": "./src/lib/components/zigzag-error/index.ts",
      "default": "./dist/components/zigzag-error/index.js"
    },
    "./spinner": {
      "development": "./src/lib/components/spinner/index.ts",
      "default": "./dist/components/spinner/index.js"
    },
    "./switch": {
      "development": "./src/lib/components/switch/index.ts",
      "default": "./dist/components/switch/index.js"
    },
    "./tooltip": {
      "development": "./src/lib/components/tooltip/index.ts",
      "default": "./dist/components/tooltip/index.js"
    },
    "./virtual-list": {
      "development": "./src/lib/components/virtual-list/index.ts",
      "svelte": "./dist/components/virtual-list/index.js",
      "default": "./dist/components/virtual-list/index.js"
    },
    "./providers": {
      "development": "./src/lib/providers/index.ts",
      "default": "./dist/providers/index.js"
    },
    "./storybook": {
      "development": "./src/lib/storybook/index.ts",
      "default": "./dist/storybook/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "!src/lib/**/*.test.*",
    "!src/lib/**/*.stories.*"
  ],
  "scripts": {
    "build": "node scripts/highlight-languages.mjs --check && svelte-package --tsconfig tsconfig.build.json",
    "build:storybook": "storybook build --stats-json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' './scripts/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "svelte-check --tsconfig tsconfig.check.json --fail-on-warnings --compiler-warnings \"state_referenced_locally:ignore,a11y_no_static_element_interactions:ignore\"",
    "codegen:types": "tsx scripts/generate-icon-names.ts",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' './scripts/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "prepare": "turbo codegen:types --output-logs errors-only",
    "prepare:test:storybook": "playwright install --with-deps",
    "prepublishOnly": "turbo build",
    "publish:storybook": "chromatic",
    "storybook": "storybook dev -p 6007",
    "test": "vitest run",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:watch": "vitest --project storybook",
    "test:unit": "POOLSIDE_SKIP_STORYBOOK_VITE=1 vitest run --project unit",
    "test:unit:watch": "POOLSIDE_SKIP_STORYBOOK_VITE=1 vitest --project unit",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@melt-ui/svelte": "catalog:",
    "@pierre/diffs": "^1.2.12",
    "@poolsideai/diff": "workspace:*",
    "@poolsideai/lib": "workspace:*",
    "@poolsideai/tailwind-config": "workspace:*",
    "bits-ui": "^2.14.4",
    "dompurify": "3.4.12",
    "fuzzysort": "^3.1.0",
    "html-entities": "^2.6.0",
    "html-escaper": "^3.0.3",
    "katex": "0.16.22",
    "lodash": "catalog:",
    "marked": "^15.0.6",
    "mermaid": "^11.16.1",
    "parse-diff": "^0.11.1",
    "prosemirror-codemark": "^0.4.2",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.2",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.3",
    "shiki": "^4.3.1",
    "svelte-copy": "^2.0.0",
    "svelte-time": "^2.0.2",
    "three": "^0.173.0",
    "type-fest": "catalog:",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@poolsideai/eslint-config": "workspace:*",
    "@poolsideai/prettier-config": "workspace:*",
    "@poolsideai/storybook-config": "workspace:*",
    "@poolsideai/svelte-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "@poolsideai/vite-config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-svelte-csf": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/svelte-vite": "catalog:",
    "@sveltejs/package": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@testing-library/user-event": "^14.6.1",
    "@types/html-escaper": "^3.0.2",
    "@types/lodash": "catalog:",
    "@types/three": "^0.173.0",
    "@types/uuid": "^9.0.8",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chromatic": "catalog:",
    "eslint": "catalog:",
    "execa": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "storybook": "catalog:",
    "svelte-check": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": "catalog:",
    "tailwindcss": "catalog:"
  }
}
