{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "codegen:types": {
      "inputs": [
        "scripts/generate-icon-names.ts",
        "src/lib/icon/glyphs/**/*.svelte"
      ],
      "outputs": ["src/lib/icon/IconName.ts"]
    },
    "publish:storybook": {
      "env": [
        "GITHUB_HEAD_REF",
        "CHROMATIC_PROJECT_TOKEN",
        "CHROMATIC_ASSITANT_APP_ID"
      ]
    }
  }
}
