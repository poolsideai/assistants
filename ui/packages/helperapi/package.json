{
  "name": "@poolsideai/helperapi",
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "private": true,
  "repository": {
    "url": "https://github.com/poolsideai/assistant"
  },
  "type": "module",
  "imports": {
    "#*": {
      "development": "./src/*/index.ts",
      "default": "./dist/*/index.js"
    },
    "#*.js": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "development": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' './scripts/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "tsc --project tsconfig.check.json",
    "codegen": "orval",
    "codegen:up": "./scripts/update.sh",
    "dev": "tsc --project tsconfig.build.json --watch",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' './scripts/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "prepublishOnly": "turbo build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:watch": "vitest"
  },
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
      "prettier --ignore-unknown --write"
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "prettier": "@poolsideai/prettier-config",
  "dependencies": {
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@poolsideai/eslint-config": "workspace:*",
    "@poolsideai/prettier-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "@poolsideai/vite-config": "workspace:*",
    "@total-typescript/ts-reset": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "orval": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
