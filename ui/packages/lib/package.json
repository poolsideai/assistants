{
  "name": "@poolsideai/lib",
  "version": "2.3.53",
  "private": true,
  "description": "Reusable library functions",
  "type": "module",
  "exports": {
    "./async-state": {
      "development": "./src/async-state/index.ts",
      "default": "./dist/async-state/index.js"
    },
    "./array": {
      "development": "./src/array/index.ts",
      "default": "./dist/array/index.js"
    },
    "./errors": {
      "development": "./src/errors/index.ts",
      "default": "./dist/errors/index.js"
    },
    "./guard": {
      "development": "./src/guard/index.ts",
      "default": "./dist/guard/index.js"
    },
    "./map": {
      "development": "./src/map/index.ts",
      "default": "./dist/map/index.js"
    },
    "./path": {
      "development": "./src/path/index.ts",
      "default": "./dist/path/index.js"
    },
    "./path-query": {
      "development": "./src/path-query/index.ts",
      "default": "./dist/path-query/index.js"
    },
    "./promise": {
      "development": "./src/promise/index.ts",
      "default": "./dist/promise/index.js"
    },
    "./string": {
      "development": "./src/string/index.ts",
      "default": "./dist/string/index.js"
    },
    "./types": {
      "development": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "tsc --project tsconfig.check.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "prepublishOnly": "turbo build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@poolsideai/prettier-config",
  "dependencies": {
    "nanoid": "^5.1.16",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@poolsideai/eslint-config": "workspace:*",
    "@poolsideai/prettier-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "@poolsideai/vite-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
