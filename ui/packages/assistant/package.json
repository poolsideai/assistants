{
  "name": "@poolsideai/assistant",
  "version": "2.3.53",
  "private": true,
  "repository": {
    "url": "https://github.com/poolsideai/assistant"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "imports": {
    "#tailwind.css": "./src/tailwind.css"
  },
  "exports": {
    ".": {
      "development": "./src/main.ts",
      "types": "./src/main.ts",
      "svelte": "./dist/main.js"
    },
    "./debug-rpc": {
      "development": "./src/lib/rpc/debugRPC.ts",
      "types": "./src/lib/rpc/debugRPC.ts",
      "default": "./src/lib/rpc/debugRPC.ts"
    },
    "./debug-rpc/acp": {
      "development": "./src/lib/rpc/acpDebugRPC.ts",
      "types": "./src/lib/rpc/acpDebugRPC.ts",
      "default": "./src/lib/rpc/acpDebugRPC.ts"
    },
    "./shared/language": {
      "development": "./src/shared/language.ts",
      "types": "./dist/shared/language.d.ts",
      "default": "./dist/shared/language.js"
    },
    "./syntax-theme.css": "./src/syntax-theme.css",
    "./tauri-drag-drop": {
      "development": "./src/acp/runtime/desktop/TauriDragDrop.svelte.ts",
      "types": "./src/acp/runtime/desktop/TauriDragDrop.svelte.ts",
      "default": "./src/acp/runtime/desktop/TauriDragDrop.svelte.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "src",
    "dist",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*"
  ],
  "scripts": {
    "build": "svelte-package --input src --tsconfig tsconfig.build.json",
    "build:storybook": "storybook build --stats-json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "svelte-check --tsconfig tsconfig.check.json",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "prepare:test:storybook": "playwright install --with-deps",
    "prepublishOnly": "turbo build",
    "preview": "vite preview",
    "publish:storybook": "chromatic",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:watch": "vitest --project storybook",
    "test:unit": "POOLSIDE_SKIP_STORYBOOK_VITE=1 vitest run --project unit",
    "test:unit:watch": "POOLSIDE_SKIP_STORYBOOK_VITE=1 vitest --project unit",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.28.1",
    "@melt-ui/svelte": "catalog:",
    "@poolsideai/components": "workspace:*",
    "@poolsideai/features": "workspace:*",
    "@poolsideai/helperapi": "workspace:*",
    "@poolsideai/lib": "workspace:*",
    "@poolsideai/rpc": "workspace:*",
    "@rive-app/canvas-lite": "^2.25.7",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "autosize": "^6.0.1",
    "lodash": "catalog:",
    "luxon": "catalog:",
    "marked": "^15.0.6",
    "serialize-error": "^11.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@poolsideai/eslint-config": "workspace:*",
    "@poolsideai/prettier-config": "workspace:*",
    "@poolsideai/storybook-config": "workspace:*",
    "@poolsideai/svelte-config": "workspace:*",
    "@poolsideai/tailwind-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "@poolsideai/vite-config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-svelte-csf": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/svelte-vite": "catalog:",
    "@sveltejs/package": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@total-typescript/ts-reset": "catalog:",
    "@types/autosize": "^4.0.3",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "@types/uuid": "^9.0.8",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chromatic": "catalog:",
    "eslint": "catalog:",
    "katex": "^0.16.22",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "storybook": "catalog:",
    "svelte-check": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": "catalog:",
    "tailwindcss": "catalog:"
  }
}
