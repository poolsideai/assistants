{
  "name": "@poolsideai/rpc",
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "description": "Inter process communication protocol for poolside assistants",
  "repository": {
    "url": "https://github.com/poolsideai/assistant"
  },
  "type": "module",
  "imports": {
    "#*": {
      "development": "./src/*/index.ts",
      "default": "./dist/*/index.js"
    },
    "#*.js": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/host.ts",
      "default": "./dist/host.js"
    },
    "./assistant": {
      "types": "./src/assistant.ts",
      "development": "./src/assistant.ts",
      "default": "./dist/assistant.js"
    },
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "tsc --project tsconfig.check.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "prepublishOnly": "turbo build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:watch": "vitest"
  },
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
      "prettier --ignore-unknown --write"
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "prettier": "@poolsideai/prettier-config",
  "dependencies": {
    "@poolsideai/helperapi": "workspace:*",
    "lodash": "catalog:",
    "luxon": "catalog:",
    "serialize-error": "^11.0.3"
  },
  "devDependencies": {
    "@poolsideai/eslint-config": "workspace:*",
    "@poolsideai/prettier-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "@poolsideai/vite-config": "workspace:*",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
