{
  "name": "@poolsideai/vite-config",
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "private": true,
  "description": "Common vite configuration",
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "tsc --project tsconfig.check.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "prepare": "turbo build --output-logs errors-only",
    "prepublishOnly": "turbo build"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@poolsideai/prettier-config",
  "dependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@melt-ui/pp": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/svelte-vite": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/svelte": "catalog:",
    "get-tsconfig": "^4.10.1",
    "glob": "catalog:",
    "magic-string": "^0.30.21",
    "read-pkg": "catalog:"
  },
  "devDependencies": {
    "@poolsideai/eslint-config": "workspace:*",
    "@poolsideai/prettier-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "^20.10.6",
    "jsdom": "^27.0.1",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": "catalog:",
    "svelte": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
