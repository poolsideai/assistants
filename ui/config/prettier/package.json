{
  "name": "@poolsideai/prettier-config",
  "version": "2.3.53",
  "private": true,
  "description": "Common prettier configuration",
  "type": "module",
  "exports": "./src/index.js",
  "scripts": {
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@poolsideai/prettier-config",
  "dependencies": {
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.19",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.13"
  },
  "devDependencies": {
    "eslint": "catalog:"
  },
  "peerDependencies": {
    "prettier": "catalog:"
  }
}
