{
  "name": "@poolsideai/eslint-config",
  "version": "2.3.53",
  "private": true,
  "description": "Common eslint configuration",
  "type": "module",
  "imports": {
    "#configs/*": "./dist/configs/*.js",
    "#plugins/*": "./dist/plugins/*.js",
    "#*.js": "./dist/*.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:format": "prettier . --check --cache --ignore-path ../../.gitignore",
    "check:lint": "pnpm build && eslint --no-error-on-unmatched-pattern './src/**/*.ts'",
    "check:types": "tsc --project tsconfig.check.json",
    "fix:format": "prettier . --write --cache --ignore-path ../../.gitignore",
    "fix:lint": "pnpm build && eslint --no-error-on-unmatched-pattern './src/**/*.ts' --fix",
    "prepare": "turbo build --output-logs errors-only",
    "prepublishOnly": "turbo build"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@poolsideai/prettier-config",
  "dependencies": {
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "read-pkg": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@poolsideai/prettier-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
