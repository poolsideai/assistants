{
  "name": "@poolsideai/desktop-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "The Poolside desktop assistant shell.",
  "repository": {
    "type": "git",
    "url": "https://github.com/poolsideai/assistant"
  },
  "author": {
    "name": "Poolside",
    "email": "hello@poolside.ai",
    "url": "https://poolside.ai"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:frontend": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "build:isolation": "node scripts/build-isolation.mjs",
    "build:web": "pnpm build:frontend && pnpm build:isolation",
    "check:format": "prettier . --check --cache --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "check:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' './isolation/**/*.{js,mjs,cjs,ts,tsx,svelte}'",
    "check:types": "svelte-check --tsconfig tsconfig.check.json --fail-on-warnings --compiler-warnings \"state_referenced_locally:ignore,a11y_no_static_element_interactions:ignore\"",
    "dev": "pnpm download:binaries && tauri dev",
    "dev:web": "pnpm build:isolation && vite --host 127.0.0.1",
    "download:binaries": "node scripts/copy-helper.mjs",
    "download:binaries:refresh": "node scripts/copy-helper.mjs --refresh",
    "fix:format": "prettier . --write --cache --ignore-path .gitignore --ignore-path ../../.gitignore --ignore-path .prettierignore --list-different",
    "fix:lint": "eslint --no-error-on-unmatched-pattern './src/**/*.{js,mjs,cjs,ts,tsx,svelte}' './isolation/**/*.{js,mjs,cjs,ts,tsx,svelte}' --fix",
    "icons:macos": "node scripts/compile-macos-icon.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:unit": "node --test src/desktopBootstrap.test.ts"
  },
  "lint-staged": {
    "*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "prettier": "@poolsideai/prettier-config",
  "dependencies": {
    "@iconify-json/vscode-icons": "^1.2.50",
    "@poolsideai/assistant": "workspace:*",
    "@poolsideai/components": "workspace:*",
    "@poolsideai/features": "workspace:*",
    "@poolsideai/helperapi": "workspace:*",
    "@poolsideai/lib": "workspace:*",
    "@poolsideai/rpc": "workspace:*",
    "@tauri-apps/api": "2",
    "@tauri-apps/plugin-dialog": "2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "2",
    "@tauri-apps/plugin-updater": "2",
    "dom-accessibility-api": "0.6.3",
    "html-to-image": "^1.11.13",
    "tauri-plugin-screenshots-api": "^2.2.0",
    "vscode-icons-js": "^11.6.1"
  },
  "devDependencies": {
    "@poolsideai/eslint-config": "workspace:*",
    "@poolsideai/prettier-config": "workspace:*",
    "@poolsideai/svelte-config": "workspace:*",
    "@poolsideai/tailwind-config": "workspace:*",
    "@poolsideai/tsconfig": "workspace:*",
    "@poolsideai/vite-config": "workspace:*",
    "@tauri-apps/cli": "2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
