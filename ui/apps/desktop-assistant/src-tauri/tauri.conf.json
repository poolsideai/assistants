{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poolside",
  "mainBinaryName": "Poolside",
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "identifier": "ai.poolside.desktop-assistant",
  "build": {
    "runner": "mbx",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "beforeBundleCommand": "node scripts/set-macos-build-sdk.mjs",
    "devUrl": "http://localhost:5177",
    "frontendDist": "../dist"
  },
  "app": {
__POOL_SYNTHETIC_IMPORT_BASELINE__
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Poolside",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        },
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../dist-isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
__POOL_SYNTHETIC_IMPORT_BASELINE__
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/poolside-helper",
      "binaries/poolside-mlx-sidecar",
      "binaries/poolside-whisper-server"
    ],
    "resources": {
      "Credits.html": "Credits.html",
      "binaries/default.metallib": "default.metallib"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Poolside",
    "longDescription": "Poolside for desktop",
    "macOS": {
      "bundleName": "Poolside",
      "entitlements": "Entitlements.plist"
    }
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
  }
}
