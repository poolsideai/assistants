{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poolside",
  "mainBinaryName": "Poolside",
  "version": "0.0.0",
  "identifier": "ai.poolside.desktop-assistant",
  "build": {
    "runner": "mbx",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "beforeBundleCommand": "node scripts/set-macos-build-sdk.mjs",
    "devUrl": "http://localhost:5177",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Poolside",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        },
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../dist-isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/poolside-helper",
      "binaries/poolside-mlx-sidecar",
      "binaries/poolside-whisper-server"
    ],
    "resources": {
      "Credits.html": "Credits.html",
      "binaries/default.metallib": "default.metallib"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Poolside",
    "longDescription": "Poolside for desktop",
    "macOS": {
      "bundleName": "Poolside",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.crabnebula.app/update/poolside/desktop-assistant/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBRUQ5ODRERjk1MTkxNjkKUldScGtWSDVUWmp0dXY1Z3E2YU9HNjNoV2RmcTFCRS9ZNU1DUWdtMVlvaW9QUjZ2dHZjVnFobXkK"
    }
  }
}
