{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "download:binaries": {
      "cache": false,
      "passThroughEnv": [
        "CARGO_BUILD_TARGET",
        "GH_TOKEN",
        "POOLSIDE_*",
        "TARGET_TRIPLE"
      ]
    },
    "build": {
__POOL_SYNTHETIC_IMPORT_BASELINE__
      "env": ["SKIP_DESKTOP_TAURI_BUILD"],
      "passThroughEnv": [
        "CARGO_BUILD_TARGET",
        "GH_TOKEN",
        "POOLSIDE_*",
        "TARGET_TRIPLE"
      ],
      "outputs": [
        "dist/**",
        "dist-isolation/**",
        "src-tauri/target/**",
        "src-tauri/binaries/poolside-helper-*",
        "src-tauri/binaries/poolside-mlx-sidecar-*",
        "src-tauri/binaries/poolside-whisper-server-*",
        "src-tauri/binaries/pool-*"
      ]
    },
    "build:web": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-isolation/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["download:binaries", "^build"],
      "persistent": true,
      "passThroughEnv": [
        "CARGO_BUILD_TARGET",
        "GH_TOKEN",
        "POOLSIDE_*",
        "TARGET_TRIPLE"
      ]
    }
  }
}
