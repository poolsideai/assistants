    "preview": "vite preview",
    "publish": "vsce publish --allow-all-proposed-apis",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:watch": "vitest"
  },
