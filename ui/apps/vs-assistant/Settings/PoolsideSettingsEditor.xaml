<UserControl x:Class="Poolside.Assistant.Settings.PoolsideSettingsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Poolside.Assistant.Settings"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <TextBlock Text="Base URI:" Margin="0,0,0,2"/>
            <TextBox Name="UriTextBox" Margin="0,0,0,10" Padding="2" VerticalContentAlignment="Center"/>
            <TextBlock Text="Default working directory (used when no folder or solution is open; leave empty for a scratch directory under %LOCALAPPDATA%\poolside\scratch):"
                       Margin="0,0,0,2" TextWrapping="Wrap"/>
            <TextBox Name="DefaultWorkingDirectoryTextBox" Margin="0,0,0,10" Padding="2" VerticalContentAlignment="Center"/>
            <CheckBox Name="WrapLinesCheckBox" Margin="0,0,0,5">
                <TextBlock Text="Wrap lines in code snippets" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox Name="NotifyOnApprovalCheckBox" Margin="0,0,0,5">
                <TextBlock Text="Show a system notification when approval is needed and the window is not focused" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox Name="ShowMermaidDiagramsCheckBox" Margin="0,0,0,5">
                <TextBlock Text="Visualise Mermaid diagrams in code blocks (experimental)" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="Tool activity (how much detail to show while the agent works):" Margin="0,5,0,2" TextWrapping="Wrap"/>
            <ComboBox Name="ToolActivityComboBox" Margin="0,0,0,10" Width="200" HorizontalAlignment="Left">
                <ComboBoxItem Tag="detailed">Detailed</ComboBoxItem>
                <ComboBoxItem Tag="grouped">Grouped</ComboBoxItem>
                <ComboBoxItem Tag="compact">Compact</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="ACP agent servers (JSON): named servers available to the ACP client, mapping a name to { command, args, env, default_config_options }. Use {{SELF}} as the command for the bundled Poolside agent. Leave empty to use the default."
                       Margin="0,10,0,2" TextWrapping="Wrap"/>
            <TextBox Name="AcpAgentServersTextBox" Margin="0,0,0,4" Padding="2"
                     AcceptsReturn="True" TextWrapping="NoWrap" MinLines="4" MaxLines="14"
                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextChanged="AcpAgentServersTextBox_TextChanged"/>
            <TextBlock Name="AcpAgentServersError" Foreground="#FFC00000" TextWrapping="Wrap"
                       Margin="0,0,0,10" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
