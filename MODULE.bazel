bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.51.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "3.1.0")
bazel_dep(name = "circl", version = "1.3.8")
bazel_dep(name = "sqlite3", version = "3.49.0")

# The helper uses CGO dependencies, including SQLite, that need cross compilation.
# Setting up bazel cross-toolchains is notoriously complicated.
# The https://github.com/uber/hermetic_cc_toolchain project found a practical solution
# leveraging the zig toolchain's excellent builtin support for cross C/C++ toolchains.
# Read historical context at https://news.ycombinator.com/item?id=28104996,
# https://dev.to/kristoff/zig-makes-go-cross-compilation-just-work-29ho, and https://jakstys.lt/2022/how-uber-uses-zig/.
toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    # Musl (libc-aware): only selected for platforms that explicitly declare
    # @zig_sdk//libc:musl. Used by poolside-helper for fully static Linux binaries.
    "@zig_sdk//libc_aware/toolchain:linux_amd64_musl",
    "@zig_sdk//libc_aware/toolchain:linux_arm64_musl",
    # Glibc 2.17 (unconstrained): fallback for all other Linux platforms.
    "@zig_sdk//toolchain:linux_amd64_gnu.2.17",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.17",
    # Windows uses Zig's bundled MinGW CRT — no runtime changes needed
    "@zig_sdk//toolchain:windows_amd64",
    "@zig_sdk//toolchain:windows_arm64",
)

single_version_override(
    module_name = "hermetic_cc_toolchain",
    patch_strip = 1,
    patches = ["//patches/hermetic_cc_toolchain:arm64-present-gold-linker.patch"],
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.1")
go_sdk.nogo(
    excludes = [
        "//third_party:__subpackages__",
    ],
    # This controls validation, not diagnostics.
    includes = [
        "//:__subpackages__",
    ],
    nogo = "//:nogo",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_override(
    directives = ["gazelle:build_tags fts5"],
    path = "github.com/mattn/go-sqlite3",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches/mattn_go_sqlite3:no_nogo.patch"],
    path = "github.com/mattn/go-sqlite3",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches/godbus_dbus_v5:no_nogo.patch"],
    path = "github.com/godbus/dbus/v5",
)
use_repo(
    go_deps,
    "co_honnef_go_tools",
    "com_github_adrg_xdg",
    "com_github_coder_acp_go_sdk",
    "com_github_creack_pty",
    "com_github_danielgtaylor_huma_v2",
    "com_github_dustin_go_humanize",
    "com_github_go_chi_chi_v5",
    "com_github_go_git_go_billy_v5",
    "com_github_go_git_go_git_v5",
    "com_github_golang_jwt_jwt_v5",
    "com_github_golang_migrate_migrate_v4",
    "com_github_google_go_cmp",
    "com_github_google_uuid",
    "com_github_gordonklaus_ineffassign",
    "com_github_gorilla_websocket",
    "com_github_hashicorp_golang_lru_v2",
    "com_github_mattn_go_sqlite3",
    "com_github_mitchellh_mapstructure",
    "com_github_pkg_errors",
    "com_github_sahilm_fuzzy",
    "com_github_samber_lo",
    "com_github_sourcegraph_jsonrpc2",
    "com_github_spf13_afero",
    "com_github_spf13_cobra",
    "com_github_stretchr_testify",
    "com_github_tliron_glsp",
    "com_github_zalando_go_keyring",
    "in_gopkg_yaml_v3",
    "org_golang_x_mod",
    "org_golang_x_net",
    "org_golang_x_oauth2",
    "org_golang_x_telemetry",
    "org_golang_x_tools",
)

bazel_dep(
    name = "buildifier_prebuilt",
    version = "6.4.0",
    dev_dependency = True,
)
