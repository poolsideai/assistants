{
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    // The vscode extension sets tabSize to 4 by default while the formatter outside of Vscode defaults to 2.
    "editor.tabSize": 2
  },
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "[typescript][javascript][svelte][json][jsonc]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.ruby-lsp": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/node_modules/**/*": true,
    "**/Thumbs.db": true,
    "node_modules": true
  },
  "go.lintOnSave": "package",
  "go.lintTool": "golangci-lint",
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
    // behave erronisouly, see discussion on the bazel/gopls interaction here:
    // https://bitworking.org/news/2021/06/bazel-and-gopls/
    "build.directoryFilters": [
      "-bazel-bin",
      "-bazel-out",
      "-bazel-testlogs"
    ]
__POOL_SYNTHETIC_IMPORT_BASELINE__
  "search.exclude": {
    "**/.svelte-kit": true,
    "**/.turbo": true,
    "**/*.code-search": true,
    "**/*.tsbuildinfo": true,
    "**/bower_components": true,
    "**/dist": true,
    "**/node_modules": true,
    "pnpm-lock.yaml": true
  },
  "svelte.enable-ts-plugin": true,
  "svelte.plugin.svelte.defaultScriptLanguage": "ts",
  "tailwindCSS.classFunctions": ["tv", "mergeProps"],
  "typescript.preferences.autoImportSpecifierExcludeRegexes": [
    "src",
    "dist",
    "node_modules"
  ],
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.preferences.useAliasesForRenames": false,
  "typescript.updateImportsOnFileMove.enabled": "always"
}
