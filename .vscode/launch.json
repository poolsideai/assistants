    {
      "name": "Debug go test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Debug: attach to Helper",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 21370,
      "host": "127.0.0.1"
    },
    {
      "name": "Launch Desktop Assistant",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-F",
        "@poolsideai/desktop-assistant",
        "dev",
        "--config",
        "{\"identifier\":\"ai.poolside.desktop-assistant.dev\",\"productName\":\"Poolside Dev\",\"mainBinaryName\":\"Poolside Dev\"}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "vscode-assistant-dev",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/ui/apps/vscode-assistant",
        "--disable-extension=poolside-ai.acp-assistant",
        "--profile=local-development",
        "${workspaceFolder}/../poolside-books-api-demo/",
        "${workspaceFolder}"
      ],
__POOL_SYNTHETIC_IMPORT_BASELINE__
__POOL_SYNTHETIC_IMPORT_BASELINE__
      ]
    },
