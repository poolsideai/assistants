#!/bin/sh

# Skip all hooks if SKIP_HOOKS environment variable is set
if [ "$SKIP_HOOKS" = "true" ]; then
  echo "Skipping all hooks"
  exit 0
fi

# Load mise environment for node/pnpm
if [ -x ~/.local/bin/mise ]; then
  eval "$(~/.local/bin/mise activate bash)"
fi

# JS/TS: lint-staged (skip with SKIP_LINT_STAGED=true)
if [ "$SKIP_LINT_STAGED" != "true" ]; then
  pnpm lint-staged --allow-empty
fi

# Go: gofmt (opt-in with PRECOMMIT_GO_FMT=true)
if [ "$PRECOMMIT_GO_FMT" = "true" ]; then
  # Keep exclusions in sync with .github/workflows/gofmt.yml
  staged_go_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go' | grep -v -E '(^third_party/|^pkg/poolside-helper/(gopls|internal/gopls)/)' || true)
  if [ -n "$staged_go_files" ]; then
    echo "Running gofmt on staged Go files..."
    gofmt -w $staged_go_files
    echo "$staged_go_files" | xargs git add
  fi
fi

# Python: pre-commit (skip with SKIP_PRE_COMMIT=true)
if [ "$SKIP_PRE_COMMIT" != "true" ]; then
  staged_py_files=$(git diff --cached --name-only -- '*.py')
  if [ -n "$staged_py_files" ]; then
    echo "Running pre-commit hooks for Python files"
    uv run pre-commit run --files $staged_py_files
  fi
fi
